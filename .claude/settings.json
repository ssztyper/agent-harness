{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/hooks/outward-guard.mjs", "timeout": 10 } ] },
      { "matcher": "mcp__.*", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/hooks/outward-guard.mjs", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/hooks/recheck-stop.mjs", "timeout": 60 } ] }
    ]
  }
}

# Harness evals: one case per rule or tool behaviour. Run from the repo root: node tools/eval.mjs evals/harness.jsonl
# Guard: outward actions ask, irreversible ones are refused, text that only mentions a command is ignored.
{"id":"guard-asks-on-push","cmd":"echo '{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git push origin main\"}}' | AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs","expect":{"json":[{"path":"hookSpecificOutput.permissionDecision","equals":"ask"}]}}
{"id":"guard-asks-on-chained-push","cmd":"echo '{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git add -A && git commit -qm \\\"m\\\" && git push -q\"}}' | AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs","expect":{"json":[{"path":"hookSpecificOutput.permissionDecision","equals":"ask"}]}}
{"id":"guard-asks-on-secret","cmd":"echo '{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"printf x | gh secret set K -R a/b\"}}' | AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs","expect":{"json":[{"path":"hookSpecificOutput.permissionDecision","equals":"ask"}]}}
{"id":"guard-asks-on-post","cmd":"echo '{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"curl -s -X POST https://api.example.com/x\"}}' | AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs","expect":{"json":[{"path":"hookSpecificOutput.permissionDecision","equals":"ask"}]}}
{"id":"guard-asks-on-deploy","cmd":"echo '{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"npx wrangler deploy\"}}' | AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs","expect":{"json":[{"path":"hookSpecificOutput.permissionDecision","equals":"ask"}]}}
{"id":"guard-denies-home-wipe","cmd":"echo '{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"rm -rf ~\"}}' | AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs","expect":{"json":[{"path":"hookSpecificOutput.permissionDecision","equals":"deny"}]}}
{"id":"guard-allows-read","cmd":"echo '{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git status && curl -s https://example.com\"}}' | AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs; echo exit=$?","expect":{"contains":["exit=0"],"absent":["permissionDecision"]}}
{"id":"guard-ignores-heredoc-text","cmd":"node -e 'console.log(JSON.stringify({tool_name:\"Bash\",tool_input:{command:\"python3 - <<EOF\\nx=\\\"gh secret set K\\\"\\nEOF\"}}))' | AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs; echo exit=$?","expect":{"contains":["exit=0"],"absent":["permissionDecision"]}}
{"id":"guard-ignores-quoted-text","cmd":"echo '{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"grep -c \\\"git push\\\" notes.md\"}}' | AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs; echo exit=$?","expect":{"contains":["exit=0"],"absent":["permissionDecision"]}}
{"id":"guard-logs-masked","cmd":"L=$(mktemp); echo '{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git push https://x:ghp_0123456789abcdefghijklmnopqrstuvwxyzABCD@github.com/a/b\"}}' | AUTONOMY_LOG=$L node hooks/outward-guard.mjs >/dev/null; cat $L","expect":{"contains":["<masked>","\"decision\":\"ask\""],"absent":["ghp_0123456789"]}}
{"id":"guard-asks-on-outward-mcp-tool","cmd":"AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs < evals/fixtures/guard/mcp-send.json","expect":{"json":[{"path":"hookSpecificOutput.permissionDecision","equals":"ask"}]}}
{"id":"guard-allows-mcp-read","cmd":"AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs < evals/fixtures/guard/mcp-read.json; echo exit=$?","expect":{"contains":["exit=0"],"absent":["permissionDecision"]}}
{"id":"guard-asks-on-inline-write-to-unknown-host","cmd":"AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs < evals/fixtures/guard/inline-post.json","expect":{"json":[{"path":"hookSpecificOutput.permissionDecision","equals":"ask"}],"contains":["collector.example.net"]}}
{"id":"guard-allows-write-to-listed-host","cmd":"AUTONOMY_LOG=/dev/null node hooks/outward-guard.mjs < evals/fixtures/guard/local-post.json; echo exit=$?","expect":{"contains":["exit=0"],"absent":["permissionDecision"]}}
# Red/green: an agent-written test must fail on the base and pass with the fix.
{"id":"redgreen-accepts-real-test","cmd":"node tools/redgreen.mjs --base evals/fixtures/redgreen/base --fix evals/fixtures/redgreen/fix --test evals/fixtures/redgreen/tests/add.test.mjs --as test/rg.test.mjs --runner 'node --test' --logs $(mktemp -d)","expect":{"exit":0,"contains":["fails on the base on an assertion, passes with the fix"]}}
{"id":"redgreen-rejects-always-green","cmd":"node tools/redgreen.mjs --base evals/fixtures/redgreen/base --fix evals/fixtures/redgreen/fix --test evals/fixtures/redgreen/tests/always-green.test.mjs --as test/rg.test.mjs --runner 'node --test' --logs $(mktemp -d)","expect":{"contains":["NOT red/green","PASSES on the base"]}}
# Eval runner fails on a bad case; session logs turn into text.
{"id":"eval-runner-fails-on-bad-case","cmd":"F=$(mktemp); echo '{\"id\":\"x\",\"cmd\":\"echo hi\",\"expect\":{\"contains\":[\"bye\"]}}' > $F; node tools/eval.mjs $F --out $(mktemp) >/dev/null; echo exit=$?","expect":{"contains":["exit=1"]}}
{"id":"eval-repeat-catches-flaky","cmd":"C=$(mktemp); FLAKY_COUNTER=$C node tools/eval.mjs evals/fixtures/flaky.jsonl --out $(mktemp) >/dev/null; echo once=$?; C=$(mktemp); FLAKY_COUNTER=$C node tools/eval.mjs evals/fixtures/flaky.jsonl --repeat 3 --out $(mktemp); echo repeat=$?","expect":{"contains":["once=0","FLAKY f \u00b7 2/3 runs","repeat=1"]}}
{"id":"session-text-reads-claude-log","cmd":"O=$(mktemp); python3 -I tools/session-text.py evals/fixtures/session.jsonl $O && cat $O","expect":{"contains":["USER: hello harness","CALL Bash"]}}
# Rules the harness learned stay written down.
{"id":"rules-have-reasons","kind":"text","cmd":"awk '/^## Boundaries/{f=1;next} /^## /{f=0} f' CLAUDE.md | awk '/^- /{if(r!=\"\")print r; r=$0; next} {r=r\" \"$0} END{print r}' | grep -vc because || true","expect":{"regex":"^0$"}}
{"id":"contract-has-outcome-gate","kind":"text","cmd":"grep -c 'Outcome\\*\\* checked live' $(ls skills/gated-contract/SKILL.md .claude/skills/gated-contract/SKILL.md 2>/dev/null | head -1)","expect":{"regex":"^1$"}}
{"id":"contract-remote-is-another-network","kind":"text","cmd":"grep -c 'another network' $(ls skills/gated-contract/SKILL.md .claude/skills/gated-contract/SKILL.md 2>/dev/null | head -1)","expect":{"regex":"^[1-9]"}}
{"id":"contract-improve-step","kind":"text","cmd":"grep -c 'Improve the harness' $(ls skills/gated-contract/SKILL.md .claude/skills/gated-contract/SKILL.md 2>/dev/null | head -1)","expect":{"regex":"^1$"}}
{"id":"hooks-parse","cmd":"for f in hooks/*.mjs tools/*.mjs; do node --check $f || exit 1; done && bash -n workers/ci-worker/run.sh && bash -n schedules/harness-review.sh && node -e 'JSON.parse(require(\"fs\").readFileSync(\"hooks/outward-tools.json\",\"utf8\"))' && echo ok","expect":{"exit":0,"contains":["ok"]}}
{"id":"no-secrets-in-repo","cmd":"git ls-files -z | xargs -0 grep -lE 'ghp_[A-Za-z0-9]{30}|sk-ant-|oat01|eyJ[A-Za-z0-9_-]{40}' | grep -v '^evals/harness.jsonl$' | wc -l | tr -d ' '","expect":{"regex":"^0$"}}
{"id":"unattended-agent-rule","kind":"text","cmd":"grep -c \"checks a human code's shape before relaying it\" $(ls skills/gated-contract/SKILL.md .claude/skills/gated-contract/SKILL.md 2>/dev/null | head -1)","expect":{"regex":"^1$"}}
{"id":"batch-as-script","kind":"text","cmd":"grep -c 'runs as one script' $(ls skills/gated-contract/SKILL.md .claude/skills/gated-contract/SKILL.md 2>/dev/null | head -1)","expect":{"regex":"^1$"}}
{"id":"records-before-build","kind":"text","cmd":"grep -c 'reads every decision record first' $(ls skills/gated-contract/SKILL.md .claude/skills/gated-contract/SKILL.md 2>/dev/null | head -1)","expect":{"regex":"^1$"}}
{"id":"person-like-recording","kind":"text","cmd":"grep -c 'the way a person' $(ls skills/gated-contract/SKILL.md .claude/skills/gated-contract/SKILL.md 2>/dev/null | head -1)","expect":{"regex":"^1$"}}
{"id":"one-group-per-area","kind":"text","cmd":"grep -c 'one group per decision area' $(ls skills/gated-contract/SKILL.md .claude/skills/gated-contract/SKILL.md 2>/dev/null | head -1)","expect":{"regex":"^1$"}}
{"id":"reread-after-step","kind":"text","cmd":"grep -c '## After a step is accepted' $(ls skills/gated-contract/SKILL.md .claude/skills/gated-contract/SKILL.md 2>/dev/null | head -1)","expect":{"regex":"^1$"}}
# Policy table for custom agents: unknown acts ask, guessed acts never run alone, never stays never.
{"id":"policy-unknown-act-asks","cmd":"(node tools/policy.mjs evals/fixtures/policy.json delete_account; node tools/policy.mjs evals/fixtures/policy.json comment --guessed) 2>/dev/null | sort -u","expect":{"regex":"^ask$","absent":["alone"]}}
{"id":"policy-named-act-follows-table","cmd":"node tools/policy.mjs evals/fixtures/policy.json read_issue 2>/dev/null; echo a=$?; node tools/policy.mjs evals/fixtures/policy.json delete_data --guessed 2>/dev/null; echo n=$?","expect":{"regex":"^alone\\na=0\\nnever\\nn=4$"}}
{"id":"policy-broken-table-fails-closed","cmd":"F=$(mktemp); echo '{\"acts\":{\"x\":{\"level\":\"maybe\",\"why\":\"y\"}}}' > $F; node tools/policy.mjs $F x 2>&1; echo exit=$?","expect":{"contains":["expected alone | ask | never","exit=2"],"absent":["\nalone"]}}
# Secrets bound to hosts: filled only in headers, only for listed hosts, over https, no redirects, masked in errors.
{"id":"secret-refused-for-unlisted-host","cmd":"node tools/bound-fetch.mjs --check API_KEY https://other.example.net/x --hosts evals/fixtures/secret-hosts.json; echo exit=$?","expect":{"contains":["refuse","exit=3"],"absent":["ok:"]}}
{"id":"bound-fetch-fills-only-where-bound","cmd":"node evals/fixtures/bound-fetch-probe.mjs","expect":{"contains":["bound-host: sent filled=true redirect=manual","other-host: refuse","in-url: refuse","plain-http: refuse","redirect: refuse","error-masked: socket closed while sending Bearer <masked>"],"absent":["probe-secret-value-123"]}}
# Decision records: every record has its sections and every supersede link resolves.
{"id":"records-check-flags-missing-section","cmd":"node tools/records-check.mjs evals/fixtures/records-good; echo ok=$?; node tools/records-check.mjs evals/fixtures/records-bad; echo bad=$?","expect":{"contains":["ok=0","bad=1","Consequences","no record 9 exists"]}}
# Outbox: an irreversible effect runs once per key; an unknown outcome is refused, not retried.
{"id":"outbox-runs-once-per-key","cmd":"J=$(mktemp); for i in 1 2; do node tools/outbox.mjs $J k1 -- echo sent 2>/dev/null; done | grep -c '^sent$'","expect":{"regex":"^1$"}}
{"id":"outbox-refuses-unknown-outcome","cmd":"J=$(mktemp); echo '{\"key\":\"k2\",\"state\":\"started\",\"at\":\"2026-01-01T00:00:00Z\"}' > $J; node tools/outbox.mjs $J k2 -- echo sent 2>&1; echo exit=$?","expect":{"contains":["never finished","exit=5"],"absent":["\nsent"]}}
# Evidence: every cited "Shown by" file exists and is not empty.
{"id":"evidence-check-flags-missing-file","cmd":"node tools/evidence-check.mjs evals/fixtures/notes/missing-evidence.md; echo exit=$?","expect":{"contains":["retry-run.log not found","cites no evidence file","exit=1"]}}
{"id":"evidence-check-accepts-captured-file","cmd":"node tools/evidence-check.mjs evals/fixtures/notes/good-evidence.md; echo exit=$?","expect":{"contains":["0 problems","exit=0"]}}
{"id":"evidence-inside-submission","kind":"text","cmd":"grep -c 'The checker sees only what you submit' $(ls skills/gated-contract/SKILL.md .claude/skills/gated-contract/SKILL.md 2>/dev/null | head -1)","expect":{"regex":"^1$"}}
{"id":"factory-scripts-parse","cmd":"bash -n factory/split.sh && bash -n factory/agent.sh && node --check factory/lab.mjs && node --check factory/agent-run.mjs && node --check factory/agent-feed.mjs && factory/split.sh --help | head -1 && node factory/lab.mjs --help | head -1","expect":{"exit":0,"contains":["split.sh: fork","lab: black-box"]}}
{"id":"agent-feed-skips-supporting-agents","cmd":"d=$(mktemp -d); echo '{\"hook_event_name\":\"UserPromptSubmit\",\"session_id\":\"s1\",\"prompt\":\"x\"}' | AGENT_ROLE=critic CLAUDE_PROJECT_DIR=$d node factory/agent-feed.mjs; ls $d/log/agent-feed 2>/dev/null | wc -l | tr -d ' '; rm -rf $d","expect":{"regex":"^0$"}}
{"id":"agent-feed-attaches-queued-finding-once","cmd":"d=$(mktemp -d); mkdir -p $d/log/agent-feed; echo '{\"n\":2,\"agent\":\"critic\",\"text\":\"ask how many tickets\"}' > $d/log/agent-feed/queue-main.jsonl; for i in 1 2; do echo '{\"hook_event_name\":\"UserPromptSubmit\",\"session_id\":\"s1\",\"prompt\":\"go\"}' | CLAUDE_PROJECT_DIR=$d node factory/agent-feed.mjs; echo; done; rm -rf $d","expect":{"regex":"^\\{.*ask how many tickets.*\\}\\s*$"}}
{"id":"lab-rejects-quotes-not-on-screen","cmd":"grep -c 'QUOTE CHECK: FAIL' factory/lab.mjs","expect":{"regex":"^[1-9]"}}
